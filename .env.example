WETFLOW_HOST=127.0.0.1
WETFLOW_PORT=4310
WETFLOW_DB=.wetflow/wetflow-agent.db
WETFLOW_SETTINGS_FILE=.wetflow/model-settings.json
# 模型上下文总预算；固定指令、工作流、工具和对话共同使用。
WETFLOW_CONTEXT_TOKEN_BUDGET=6000

# 留空时使用内置本地 Agent，不会访问网络。
WETFLOW_MODEL_BASE_URL=
WETFLOW_MODEL_API_KEY=
WETFLOW_MODEL=
# 可选：逗号分隔的模型候选。服务也会尝试从 Provider 的 /models 获取列表。
WETFLOW_MODELS=

# CLI：显式允许自动检索的文献片段发送给模型；Web 界面使用模型设置中的开关。
WETFLOW_ALLOW_DOCUMENT_EXCERPTS=false
